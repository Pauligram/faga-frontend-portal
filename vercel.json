{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "routes": [
    { "src": "/js/(.*)", "dest": "/js/$1" },
    { "src": "/Public-website/(.*)", "dest": "/Public-website/$1" },
    { "src": "/user-portal/(.*)", "dest": "/user-portal/$1" },
    { "src": "/admin-portal/(.*)", "dest": "/admin-portal/$1" },
    { "handle": "filesystem" }
  ]
}