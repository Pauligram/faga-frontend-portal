{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/", "destination": "/Public website/index.html" },
    { "source": "/index", "destination": "/Public website/index.html" },
    { "source": "/login", "destination": "/user portal/login.html" }
  ],
  "routes": [
    { "src": "/js/(.*)", "dest": "/js/$1" },
    { "src": "/Public%20website/(.*)", "dest": "/Public website/$1" },
    { "src": "/user%20portal/(.*)", "dest": "/user portal/$1" },
    { "src": "/admin%20portal/(.*)", "dest": "/admin portal/$1" },
    { "handle": "filesystem" }
  ]
}
